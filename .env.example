# Copy this file, rename the copy to .env.local, and fill in the values
# (ask the team for them)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Google Form for video uploads:
# the form's normal link (ends in /viewform)
VITE_GOOGLE_FORM_URL=
# the "User ID" question's entry key, e.g. entry.123456789
# (form ⋮ menu → Get pre-filled link → fill it in → copy the link and look for entry.)
VITE_GOOGLE_FORM_USER_ID_ENTRY=
